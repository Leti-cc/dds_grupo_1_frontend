<header class="topbar">
  <a class="brand" href="#/inicio" aria-label="DonaTrack, inicio">
    <span class="brand-mark" aria-hidden="true">D</span>
    <span class="brand-copy">
      <strong>DonaTrack</strong>
      <small>Logística solidaria</small>
    </span>
  </a>
  <button
    class="menu-toggle"
    type="button"
    aria-label="Abrir navegación"
    aria-expanded="false"
    aria-controls="primary-navigation"
    data-action="toggle-navigation"
  >☰</button>
  <nav class="main-nav" id="primary-navigation" aria-label="Navegación principal">
    {{#each links}}
      <a href="{{href}}" {{#if active}}aria-current="page" class="nav-link is-active"{{else}}class="nav-link"{{/if}}>{{label}}</a>
    {{/each}}
  </nav>
  <div class="topbar-actions">
    {{#if user}}
      <span class="user-chip">{{userLabel}}</span>
      <button class="button button-outline button-small" type="button" data-action="logout">Salir</button>
    {{else}}
      <a class="button button-primary button-small" href="#/login">Ingresar</a>
    {{/if}}
  </div>
</header>
<main id="main-content" class="page-container" tabindex="-1">
  {{{content}}}
</main>
<footer class="site-footer">
  <a class="brand brand-footer" href="#/inicio">
    <span class="brand-mark" aria-hidden="true">D</span>
    <span class="brand-copy"><strong>DonaTrack</strong><small>Red logística solidaria</small></span>
  </a>
  <span>Conectamos donaciones con comunidades.</span>
  <a href="#/seguimiento">Seguir una entrega</a>
</footer>
