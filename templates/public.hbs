<section class="hero-grid">
  <div class="hero-copy">
    <span class="eyebrow"><span class="status-dot"></span> Red logística abierta y transparente</span>
    <h1>Conectamos personas que quieren <span class="text-primary">ayudar</span> con quienes más lo necesitan.</h1>
    <p class="lead">DonaTrack acompaña cada donación desde su origen hasta su recepción por comedores y organizaciones comunitarias.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#/login">Sumarme a la red <span aria-hidden="true">→</span></a>
      <a class="button button-outline" href="#/seguimiento">Rastrear una entrega</a>
    </div>
    <div class="trust-list">
      <article class="trust-item"><span class="icon-tile" aria-hidden="true">↗</span><div><strong>Trazabilidad</strong><small>Seguí cada etapa</small></div></article>
      <article class="trust-item"><span class="icon-tile icon-green" aria-hidden="true">✓</span><div><strong>Transparencia</strong><small>Datos de la red</small></div></article>
      <article class="trust-item"><span class="icon-tile icon-violet" aria-hidden="true">♡</span><div><strong>Impacto real</strong><small>Ayuda directa</small></div></article>
    </div>
  </div>
  <aside class="hero-panel">
    <div class="hero-art" aria-hidden="true"><span class="hero-art-mark">D</span><span class="hero-art-ring"></span></div>
    <div class="hero-panel-caption">
      <span class="eyebrow">Una red, muchos destinos</span>
      <h2>Cada aporte cuenta. Cada entrega se puede seguir.</h2>
    </div>
  </aside>
</section>

<section class="metric-strip" aria-label="Indicadores de la red">
  <div class="metric-intro"><span class="icon-tile icon-violet" aria-hidden="true">✦</span><div><strong>La red en movimiento</strong><small>Datos actuales de los servicios</small></div></div>
  <div class="metric"><strong>{{metrics.donations}}</strong><span>Donaciones registradas</span></div>
  <div class="metric"><strong>{{metrics.entities}}</strong><span>Entidades beneficiarias</span></div>
  <div class="metric"><strong>{{metrics.delivered}}</strong><span>Entregas completadas</span></div>
</section>
{{#if errors.donations}}<p class="notice notice-error">{{errors.donations}}</p>{{/if}}
{{#if errors.entities}}<p class="notice notice-error">{{errors.entities}}</p>{{/if}}

<section class="section-block">
  <div class="section-heading">
    <div><p class="eyebrow">Trazabilidad</p><h2>Entregas recientes</h2><p class="section-description">Consultá las entregas registradas por logística.</p></div>
    <a class="text-link" href="#/seguimiento">Rastrear una entrega <span aria-hidden="true">→</span></a>
  </div>
  {{#if deliveries.length}}
    <div class="delivery-grid">
      {{#each deliveries}}
        <article class="delivery-card">
          <div class="card-topline"><span class="tag tag-green">{{statusLabel estado}}</span><span class="muted">#{{id}}</span></div>
          <h3>{{displayName}}</h3>
          <p>{{displayDescription}}</p>
          <a class="text-link" href="#/seguimiento?id={{id}}">Ver seguimiento <span aria-hidden="true">→</span></a>
        </article>
      {{/each}}
    </div>
  {{else if errors.deliveries}}
    <div class="empty-state"><strong>Las entregas no están disponibles en este momento.</strong><span>Reintentá cuando el servicio de logística esté iniciado.</span></div>
  {{else}}
    <div class="empty-state"><strong>Todavía no hay entregas para mostrar.</strong><span>Cuando se registren entregas, vas a poder consultarlas acá.</span></div>
  {{/if}}
</section>

<section class="cta-band">
  <div><p class="eyebrow">Participá</p><h2>Tu organización puede ser parte de la red.</h2><p>Ingresá al sistema para acceder a las herramientas de donantes y entidades.</p></div>
  <a class="button button-primary" href="#/login">Acceso al sistema <span aria-hidden="true">→</span></a>
</section>
