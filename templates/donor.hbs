<section class="page-heading dashboard-heading">
  <div><p class="eyebrow">Espacio de donante</p><h1>Hola{{#if userName}}, {{userName}}{{/if}}</h1><p class="lead">Consultá tus aportes, misiones e impacto en la red.</p></div>
  {{#if userName}}<span class="tag tag-violet">Perfil: {{userName}}</span>{{else}}<a class="button button-primary" href="#/login">Ingresar</a>{{/if}}
</section>
{{#if errors.profile}}<p class="notice notice-error">{{errors.profile}}</p>{{/if}}
{{#if authMessage}}<p class="notice notice-info">{{authMessage}} <a href="#/login">Ingresar</a></p>{{/if}}
<section class="metric-grid">
  <article class="metric-card"><span>Donaciones</span><strong>{{profile.donations}}</strong><small>Según perfil de incentivos</small></article>
  <article class="metric-card metric-green"><span>Impacto acumulado</span><strong>{{profile.points}}</strong><small>{{profile.level}}</small></article>
  <article class="metric-card metric-blue"><span>Misiones</span><strong>{{missions.length}}</strong><small>Progreso del período</small></article>
  <article class="metric-card metric-violet"><span>Insignias</span><strong>{{badges.length}}</strong><small>En tu vitrina</small></article>
</section>
<section class="surface-card section-block">
  <div class="section-heading"><div><p class="eyebrow">Actividad</p><h2>Mis aportes recientes</h2></div></div>
  {{#if profile.donationHistory.length}}<ul class="data-list">{{#each profile.donationHistory}}<li><div><strong>{{subcategoria}}</strong><small>{{#each bienes}}{{this}}{{#unless @last}}, {{/unless}}{{/each}} · {{organizacion}}</small></div><time class="muted">{{fechaIngreso}}</time></li>{{/each}}</ul>
  {{else if errors.profile}}<div class="empty-state compact">No se pudo cargar el historial de aportes.</div>
  {{else}}<div class="empty-state compact">No hay aportes para mostrar.</div>{{/if}}
</section>
<section class="dashboard-grid">
  <div class="surface-card">
    <div class="section-heading"><div><p class="eyebrow">Incentivos</p><h2>Misiones</h2></div></div>
    {{#if errors.missions}}<p class="notice notice-error">{{errors.missions}}</p>{{/if}}
    {{#if missions.length}}
      <ul class="data-list">{{#each missions}}<li><div><strong>{{descripcion}}</strong><small>{{progresoActual}} de {{objetivo}} completados</small></div><span class="tag {{#if completada}}tag-green{{else}}tag-blue{{/if}}">{{#if completada}}Completada{{else}}En progreso{{/if}}</span></li>{{/each}}</ul>
    {{else if errors.missions}}<div class="empty-state compact">No se pudieron cargar las misiones.</div>
    {{else}}<div class="empty-state compact">No hay misiones para mostrar.</div>{{/if}}
  </div>
  <div class="surface-card">
    <div class="section-heading"><div><p class="eyebrow">Comunidad</p><h2>Podio del mes</h2></div></div>
    {{#if errors.ranking}}<p class="notice notice-error">{{errors.ranking}}</p>{{/if}}
    {{#if ranking.length}}<ol class="ranking-list">{{#each ranking}}<li><span class="rank-number">{{puesto}}</span><strong>{{nombreUsuario}}</strong><span>{{misionesLogradas}} misiones</span></li>{{/each}}</ol>
    {{else if errors.ranking}}<div class="empty-state compact">El ranking no está disponible.</div>
    {{else}}<div class="empty-state compact">Todavía no hay un ranking publicado.</div>{{/if}}
  </div>
</section>
<section class="surface-card section-block">
  <div class="section-heading"><div><p class="eyebrow">Reconocimientos</p><h2>Mi vitrina</h2></div></div>
  {{#if errors.badges}}<p class="notice notice-error">{{errors.badges}}</p>{{/if}}
  {{#if badges.length}}<div class="badge-grid">{{#each badges}}<article class="badge-card"><span class="badge-icon" aria-hidden="true">✦</span><strong>{{nombre}}</strong></article>{{/each}}</div>
  {{else if errors.badges}}<div class="empty-state compact">No se pudieron cargar las insignias.</div>
  {{else}}<div class="empty-state compact">Las insignias obtenidas aparecerán acá.</div>{{/if}}
</section>
