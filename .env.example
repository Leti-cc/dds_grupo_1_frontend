# Servidor del frontend
PORT=3000
# Secreto para firmar la cookie de sesión. Usá un valor largo y aleatorio.
SESSION_SECRET=cambiar-por-un-secreto-largo
# true solo en desarrollo: saltea requireRole(...) de las rutas protegidas.
AUTH_DEV_BYPASS=false
# true solo para la demo: muestra "Simular respuesta del optimizador" en Logística.
ENABLE_DEMO_TOOLS=false
# Cada cuántos milisegundos se actualiza el mapa de camiones (mínimo 1000).
MAPA_POLLING_MS=10000

# URLs base de las APIs. Las usa el servidor del front, nunca el navegador.
DONACIONES_API_URL=http://localhost:8080
NOTIFICACIONES_API_URL=http://localhost:8081
INCENTIVOS_API_URL=http://localhost:8082
LOGISTICA_API_URL=http://localhost:8083
# URL base para cuando una entidad sube la foto de la ruta
PUBLIC_BASE_URL=http://localhost:3000

# OpenID Connect / Keycloak (servicio de autenticación).
KEYCLOAK_ISSUER=http://localhost:8084/realms/donatrack
KEYCLOAK_CLIENT_ID=donatrack-frontend
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback
# A dónde vuelve Keycloak después de cerrar la sesión SSO (debe estar en post.logout.redirect.uris del realm).
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
KEYCLOAK_REGISTRATION_CLIENT_ID=donatrack-registration
KEYCLOAK_REGISTRATION_CLIENT_SECRET=reemplazar-por-el-mismo-secreto-de-DonaTrack/.env
# Botones de social login. Alias de los identity providers habilitados en Keycloak, separados por coma
# (google, github). Dejar vacío si no hay ninguno configurado.
SOCIAL_LOGIN_PROVIDERS=
