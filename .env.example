# Servidor del frontend
PORT=3000
# Secreto para firmar la cookie de sesión. Usá un valor largo y aleatorio.
SESSION_SECRET=cambiar-por-un-secreto-largo
# true solo en desarrollo: saltea requireRole(...) de las rutas protegidas.
AUTH_DEV_BYPASS=false
# true solo para la demo: muestra "Simular respuesta del optimizador" en Logística.
ENABLE_DEMO_TOOLS=false

# URLs base de las APIs. Las usa el servidor del front, nunca el navegador.
DONACIONES_API_URL=http://localhost:8080
NOTIFICACIONES_API_URL=http://localhost:8081
INCENTIVOS_API_URL=http://localhost:8082
LOGISTICA_API_URL=http://localhost:8083
AUTH_API_URL=http://localhost:8084

# Configure each URL only after the authentication backend defines its routes.
AUTH_GOOGLE_URL=
AUTH_MICROSOFT_URL=
AUTH_INSTITUCIONAL_URL=
