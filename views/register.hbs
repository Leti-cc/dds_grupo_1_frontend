<div class="register-shell">
  <a class="register-back" href="/login">← Volver al inicio de sesión</a>
  {{#if registered}}
    <div class="register-complete" role="status"><span class="register-complete-icon" aria-hidden="true">✓</span><h1>Entidad registrada</h1><p>La organización y su cuenta de acceso fueron creadas correctamente.</p><a class="button button-primary" href="/login">Iniciar sesión</a></div>
  {{else}}
    <header class="register-heading"><h1>Registro de entidad beneficiaria</h1><p>Completá los datos de tu organización para registrarla en DonaTrack.</p></header>
    <ol class="register-steps" aria-label="Pasos del registro"><li class="is-current" data-step-label="1"><span>1</span>Datos de la organización</li><li data-step-label="2"><span>2</span>Datos de contacto</li><li data-step-label="3"><span>3</span>Representante</li><li data-step-label="4"><span>4</span>Confirmación</li></ol>
    {{#if error}}<p class="notice notice-error" role="alert">{{error}}</p>{{/if}}
    <form id="entity-register-form" method="post" action="/registro" novalidate>
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <fieldset class="register-panel" data-register-step="1"><legend class="visually-hidden">Datos de la organización</legend><div class="register-fields">
        <label class="field"><span>Nombre de la organización <span aria-hidden="true">*</span></span><input name="razonSocial" required minlength="3" maxlength="120" autocomplete="organization" placeholder="Ej: Comedor Esperanza" value="{{values.razonSocial}}"></label>
        <label class="field"><span>Tipo de organización <span aria-hidden="true">*</span></span><select name="tipoEntidad" required><option value="">Seleccioná una opción</option><option value="COMEDOR" {{#if (eq values.tipoEntidad "COMEDOR")}}selected{{/if}}>Comedor</option><option value="ESCUELARURAL" {{#if (eq values.tipoEntidad "ESCUELARURAL")}}selected{{/if}}>Escuela rural</option><option value="ESPACIOTUTORIA" {{#if (eq values.tipoEntidad "ESPACIOTUTORIA")}}selected{{/if}}>Espacio de tutoría</option></select></label>
        <label class="field"><span>CUIT/CUIL <span aria-hidden="true">*</span></span><input name="cuit" required inputmode="numeric" pattern="[0-9-]{11,13}" placeholder="Ej: 30-12345678-9" value="{{values.cuit}}"></label>
        <label class="field"><span>Dirección <span aria-hidden="true">*</span></span><input name="direccion" required minlength="5" maxlength="200" autocomplete="street-address" placeholder="Ej: Av. Siempre Viva 123, CABA" value="{{values.direccion}}"></label>
      </div></fieldset>
      <fieldset class="register-panel" data-register-step="2" hidden><legend>Datos de acceso</legend><p class="register-hint">El correo será el usuario para ingresar a DonaTrack.</p><div class="register-fields"><label class="field"><span>Correo electrónico <span aria-hidden="true">*</span></span><input name="email" type="email" required maxlength="254" autocomplete="email" placeholder="contacto@organizacion.org" value="{{values.email}}"></label><label class="field"><span>Contraseña <span aria-hidden="true">*</span></span><input name="password" type="password" required minlength="8" maxlength="128" autocomplete="new-password"></label><label class="field"><span>Repetir contraseña <span aria-hidden="true">*</span></span><input name="passwordConfirmation" type="password" required minlength="8" maxlength="128" autocomplete="new-password"></label></div></fieldset>
      <fieldset class="register-panel" data-register-step="3" hidden><legend>Representante</legend><p class="register-hint">Indicá la persona designada para recibir comunicaciones de DonaTrack.</p><div class="register-fields"><label class="field"><span>Nombre <span aria-hidden="true">*</span></span><input name="representanteNombre" required minlength="2" maxlength="80" autocomplete="given-name" value="{{values.representanteNombre}}"></label><label class="field"><span>Apellido <span aria-hidden="true">*</span></span><input name="representanteApellido" required minlength="2" maxlength="80" autocomplete="family-name" value="{{values.representanteApellido}}"></label></div></fieldset>
      <fieldset class="register-panel" data-register-step="4" hidden><legend>Confirmación</legend><p class="register-hint">Revisá los datos antes de enviar el registro.</p><dl class="register-summary"><div><dt>Organización</dt><dd data-summary="razonSocial"></dd></div><div><dt>Tipo</dt><dd data-summary="tipoEntidad"></dd></div><div><dt>CUIT/CUIL</dt><dd data-summary="cuit"></dd></div><div><dt>Dirección</dt><dd data-summary="direccion"></dd></div><div><dt>Contacto</dt><dd data-summary="email"></dd></div><div><dt>Representante</dt><dd data-summary="representante"></dd></div></dl></fieldset>
      <div class="register-actions"><button class="button button-outline" type="button" data-register-prev hidden>Anterior</button><button class="button button-primary" type="button" data-register-next>Siguiente</button><button class="button button-primary" type="submit" data-register-submit hidden>Registrar entidad</button></div>
    </form>
  {{/if}}
</div>
{{#unless registered}}<script type="module" src="/js/registro-entidad.js"></script>{{/unless}}
