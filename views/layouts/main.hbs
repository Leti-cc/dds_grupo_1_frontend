<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="DonaTrack conecta donantes con organizaciones comunitarias."
    />
    <meta name="theme-color" content="#f8f9ff" />
    <title>{{#if title}}{{title}} · DonaTrack{{else}}DonaTrack | Red logística solidaria{{/if}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap"
      rel="stylesheet"
    />
    {{#if leaflet}}<link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />{{/if}}
    <link rel="stylesheet" href="/css/styles.css" />
    <script type="module" src="/js/app.js"></script>
  </head>
  <body>
    <div class="page-progress" aria-hidden="true" hidden><span></span></div>
{{#unless authPage}}<header class="topbar">
  {{> brand}}
  <button
    class="menu-toggle"
    type="button"
    aria-label="Abrir navegación"
    aria-expanded="false"
    aria-controls="primary-navigation"
    data-action="toggle-navigation"
  >☰</button>
  <nav class="main-nav" id="primary-navigation" aria-label="Navegación principal">
    {{#each links}}
      <a href="{{href}}" {{#if active}}aria-current="page" class="nav-link is-active"{{else}}class="nav-link"{{/if}}>{{label}}</a>
    {{/each}}
  </nav>
  <div class="topbar-actions">
    {{#if user}}
      <span class="user-chip">{{userLabel}}</span>
      <form method="post" action="/logout"><button class="button button-outline button-small" type="submit">Salir</button></form>
    {{else}}
      <a class="button button-outline button-small" href="/login"><svg class="visitor-icon" aria-hidden="true"><use href="/images/visitante/icons.svg#login"></use></svg> Iniciar sesión</a>
      <a class="button button-primary button-small" href="/registro"><svg class="visitor-icon" aria-hidden="true"><use href="/images/visitante/icons.svg#user"></use></svg> Registrarse</a>
    {{/if}}
  </div>
</header>
{{/unless}}<main id="main-content" class="page-container{{#if authPage}} auth-main{{/if}}" tabindex="-1">
  {{{body}}}
</main>
{{#unless authPage}}<footer class="site-footer visitor-footer" id="contacto">
  {{> brand extraClass="brand-footer"}}
  <nav aria-label="Información"><a href="/#como-funciona">Sobre DonaTrack</a><a href="/#como-funciona">Cómo funciona</a><a href="/legal">Preguntas frecuentes</a><a href="/legal">Términos y condiciones</a><a href="/legal">Política de privacidad</a></nav><span>© 2026 DonaTrack. Todos los derechos reservados.</span><div class="visitor-social"><a href="/legal" aria-label="Facebook"><svg class="visitor-icon" aria-hidden="true"><use href="/images/visitante/icons.svg#facebook"></use></svg></a><a href="/legal" aria-label="Instagram"><svg class="visitor-icon" aria-hidden="true"><use href="/images/visitante/icons.svg#instagram"></use></svg></a><a href="/legal" aria-label="Correo"><svg class="visitor-icon" aria-hidden="true"><use href="/images/visitante/icons.svg#mail"></use></svg></a></div>
</footer>
{{/unless}}
    <div id="toast" class="toast" role="status" aria-live="polite"{{#if flash.toast}} data-state="{{flash.type}}"{{else}} hidden{{/if}}>{{flash.toast}}</div>
  </body>
</html>
