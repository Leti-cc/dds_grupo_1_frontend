<div class="asignaciones">
    
  <section class="page-heading">
    <div><p class="eyebrow">Donante</p><h1>Mis donaciones</h1><p class="lead">Consultá y filtrá las donaciones que realizaste.</p></div>
  </section>

  {{#if sinDonante}}<p class="notice notice-info" role="status">No pudimos identificar tu cuenta de donante. Iniciá sesión de nuevo o contactá a la administración.</p>{{/if}}
  {{#if servicioNoDisponible}}{{> asignaciones-no-disponible url=urlReintento}}{{/if}}
  {{#if errorLista}}<p class="notice notice-error" role="alert">{{errorLista}}</p>{{/if}}

  {{#unless sinDonante}}
  <section class="surface-card section-block" aria-labelledby="mis-titulo" data-carga>
    <div class="section-heading">
      <div><h2 id="mis-titulo">Tus donaciones</h2>{{#if listaCargada}}<p class="contador">{{totalTexto}}</p>{{/if}}</div>
      <form class="filtros" method="get" action="/donante/donaciones" aria-label="Filtrar mis donaciones">
        {{#if conservarDonante}}<input type="hidden" name="donanteId" value="{{conservarDonante}}">{{/if}}
        <label class="field"><span>Estado</span>
          <select name="estado">{{#each estados}}<option value="{{valor}}"{{#if seleccionado}} selected{{/if}}>{{texto}}</option>{{/each}}</select></label>
        <label class="field"><span>Categoría</span>
          <select name="categoria">{{#each categorias}}<option value="{{valor}}"{{#if seleccionado}} selected{{/if}}>{{texto}}</option>{{/each}}</select></label>
        <label class="field"><span>Subcategoría</span>
          <select name="subcategoria">{{#each subcategorias}}<option value="{{valor}}"{{#if seleccionado}} selected{{/if}}>{{texto}}</option>{{/each}}</select></label>
        <label class="field"><span>Desde</span><input type="date" name="desde" value="{{desde}}"></label>
        <label class="field"><span>Hasta</span><input type="date" name="hasta" value="{{hasta}}"></label>
        <button class="button button-primary" type="submit">Filtrar</button>
        <a class="button button-outline" href="{{urlQuitarFiltro}}">Limpiar filtros</a>
      </form>
    </div>

    {{#if donaciones.length}}
    <div class="table-wrap table-wrap-visible">
      <table class="table-cards" role="table" aria-labelledby="mis-titulo">
        <thead role="rowgroup"><tr role="row">
          <th role="columnheader" scope="col">Donación</th>
          <th role="columnheader" scope="col">Fecha</th>
          <th role="columnheader" scope="col">Subcategoría</th>
          <th role="columnheader" scope="col">Cantidad</th>
          <th role="columnheader" scope="col">Estado</th>
          <th role="columnheader" scope="col">Entidad asignada</th>
          <th role="columnheader" scope="col">Acciones</th>
        </tr></thead>
        <tbody role="rowgroup">
          {{#each donaciones}}
          <tr role="row">
            <td role="cell" data-label="Donación"><strong>{{descripcion}}</strong></td>
            <td role="cell" data-label="Fecha">{{fechaIngresoTexto}}</td>
            <td role="cell" data-label="Subcategoría">{{subcategoriaNombre}}</td>
            <td role="cell" data-label="Cantidad">{{cantidadTexto}}</td>
            <td role="cell" data-label="Estado"><span class="tag {{estado.clase}}">{{estado.texto}}</span></td>
            <td role="cell" data-label="Entidad asignada">{{#if entidadNombre}}{{entidadNombre}}{{else}}—{{/if}}</td>
            <td role="cell" data-label="Acciones"><a class="button button-outline button-small" href="{{hrefDetalle}}" aria-label="Ver el detalle de la donación {{descripcion}}">Ver detalle</a></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{> paginacion paginacion=paginacion}}
    {{else if listaCargada}}
      {{#if filtroActivo}}
      <div class="empty-state compact"><strong>No tenés donaciones con esos filtros.</strong><a class="text-link" href="{{urlQuitarFiltro}}">Quitar filtros</a></div>
      {{else}}
      <div class="empty-state compact"><strong>Todavía no registraste donaciones.</strong><span>Cuando lleves una al depósito, la vas a ver acá con su estado.</span></div>
      {{/if}}
    {{/if}}
  </section>
  {{/unless}}

</div>

<script type="module" src="/js/asignaciones/carga.js"></script>