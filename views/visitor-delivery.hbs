<section class="page-heading"><div><h1>{{delivery.name}}</h1><p class="lead">{{delivery.description}}</p></div><span class="tag tag-green">Entregada</span></section>
<article class="surface-card visitor-delivery-detail"><img src="{{delivery.photo}}" alt="Entrega a {{delivery.name}}"><div><h2>Detalle de la entrega</h2><dl class="detail-grid"><div><dt>Fecha de entrega</dt><dd>{{delivery.displayDate}}</dd></div><div><dt>Cantidad de bienes</dt><dd>{{delivery.quantity}} ítems</dd></div><div><dt>Entregado por</dt><dd>{{delivery.donor}}</dd></div></dl><p class="field-hint">Los datos de esta entrega son de demostración.</p><div class="visitor-delivery-actions"><a class="button button-outline" href="/#historias">Volver al mapa</a><a class="button button-outline" href="/galeria">Volver a la galería</a></div></div></article>
