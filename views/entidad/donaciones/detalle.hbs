<div class="asignaciones">
  <a class="text-link" href="{{volver}}">← Volver</a>
  <section class="page-heading dashboard-heading">
    <div><p class="eyebrow">Entidad · Donaciones asignadas</p><h1>Detalle de donación</h1></div>
    {{#if donacion}}<span class="tag {{donacion.estado.clase}}">{{donacion.estado.texto}}</span>{{/if}}
  </section>

  {{#if servicioNoDisponible}}{{> asignaciones-no-disponible url=urlReintento}}{{/if}}
  {{#if errorCarga}}<p class="notice notice-error" role="alert">{{errorCarga}}</p>{{/if}}

  {{#if donacion}}
  <div class="detalle-donacion">
    <section class="surface-card" aria-labelledby="datos-titulo">
      <h2 class="visually-hidden" id="datos-titulo">Datos de la donación</h2>
      <dl class="datos-lista">
        <div><dt>Subcategoría</dt><dd>{{donacion.subcategoriaNombre}}</dd></div>
        <div><dt>Descripción</dt><dd>{{donacion.descripcion}}</dd></div>
        <div><dt>Cantidad total</dt><dd>{{donacion.cantidadTexto}}</dd></div>
        <div><dt>Donante</dt><dd>{{donacion.donanteNombre}}</dd></div>
      </dl>

      {{#if donacion.items.length}}
      <h3 class="panel-subtitulo">Ítems</h3>
      <ul class="data-list items-donacion">
        {{#each donacion.items}}
        <li>
          <div><strong>{{nombre}}</strong>{{#if cantidadTexto}}<small>{{cantidadTexto}}</small>{{/if}}</div>
          <span class="muted">Vence: {{vencimientoTexto}}</span>
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </section>

    <section class="surface-card timeline" aria-labelledby="linea-titulo">
      <h2 id="linea-titulo">Seguimiento de entrega</h2>
      {{> asignaciones-linea pasos=pasos}}
      <p class="muted">El servicio todavía no informa la fecha de cada cambio de estado.</p>
    </section>
  </div>

  {{#if donacion.fotos.length}}
  <section class="surface-card" aria-labelledby="fotos-titulo">
    <h2 id="fotos-titulo">Fotos de la entrega</h2>
    <div class="galeria-entrega">
      {{#each donacion.fotos}}
      <a href="{{this}}" target="_blank" rel="noopener"><img src="{{this}}" alt="Foto de la donación recibida" loading="lazy" width="160"></a>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{#if donacion.enTraslado}}
  <section class="surface-card" aria-labelledby="recepcion-titulo">
    <h2 id="recepcion-titulo">¿Llegó la donación?</h2>
    <p class="muted">Confirmá la recepción con fotos o avisanos si no llegó.</p>
    <div class="dialog-actions">
      <button class="button button-outline" type="button" data-dialog-open="dlg-no-recibida">No la recibí</button>
      <button class="button button-primary" type="button" data-dialog-open="dlg-recibida">Confirmar recepción</button>
    </div>
  </section>

  <dialog class="dialog" id="dlg-recibida" aria-labelledby="dlg-recibida-t" aria-describedby="dlg-recibida-d">
    <h2 id="dlg-recibida-t">Confirmar recepción</h2>
    <form method="post" enctype="multipart/form-data" action="/entidad/donaciones/{{id}}/recepcion">
      <input type="hidden" name="volver" value="{{volver}}">
      <p id="dlg-recibida-d">Subí hasta 3 fotos (JPG, PNG o WebP, máx. 5 MB cada una).</p>
      <label class="field"><span>Fotos de la donación</span>
        <input type="file" name="fotos" accept="image/jpeg,image/png,image/webp" multiple required></label>
      <div class="dialog-actions">
        <button class="button button-outline" type="button" data-dialog-close>Cancelar</button>
        <button class="button button-primary" type="submit" data-busy-text="Enviando…">Confirmar</button>
      </div>
    </form>
  </dialog>

  <dialog class="dialog" id="dlg-no-recibida" aria-labelledby="dlg-no-t" aria-describedby="dlg-no-d">
    <h2 id="dlg-no-t">No recibí la donación</h2>
    <form method="post" action="/entidad/donaciones/{{id}}/no-recibida">
      <input type="hidden" name="volver" value="{{volver}}">
      <p id="dlg-no-d">La administración va a revisar el caso.</p>
      <label class="field"><span>Motivo</span>
        <textarea name="motivo" rows="3" maxlength="250" required placeholder="Ej.: nadie atendió en el horario"></textarea></label>
      <div class="dialog-actions">
        <button class="button button-outline" type="button" data-dialog-close>Cancelar</button>
        <button class="button button-primary" type="submit" data-busy-text="Enviando…">Enviar</button>
      </div>
    </form>
  </dialog>
  {{/if}}

  {{/if}}

</div>

<script type="module" src="/js/logistica/modales.js"></script>